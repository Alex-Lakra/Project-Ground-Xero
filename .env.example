# =====================================================================
# Firebase Configuration Environment Template for Project-Ground-Xero
# =====================================================================
# Copy this file to `.env.local` and replace the placeholder values with 
# your actual credentials from the Firebase Console (Project Settings -> General -> Your apps).

# Firebase Web API Key (Must start with 'AIzaSy...')
VITE_FIREBASE_API_KEY=your_firebase_api_key_here

# Firebase Auth Domain (e.g. project-ground-xero.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com

# Firebase Realtime Database URL
VITE_FIREBASE_DB_URL=https://your_project_id-default-rtdb.asia-southeast1.firebasedatabase.app

# Firebase Project ID (e.g. project-ground-xero)
VITE_FIREBASE_PROJECT_ID=your_project_id

# Firebase Storage Bucket (e.g. project-ground-xero.appspot.com)
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com

# Firebase Messaging Sender ID (Numeric ID, e.g. 123456789012)
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id

# Firebase Web App ID (e.g. 1:123456789012:web:abc123def456ghi789jkl)
VITE_FIREBASE_APP_ID=your_app_id

# Firebase Measurement ID (e.g. G-XXXXXXX)
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

